<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.vko4_tleminen.piirtoKangas
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/ColorSelectFragment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/FileMenuFragment">

    </com.example.vko4_tleminen.piirtoKangas>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/ColorSelectFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:name="com.example.vko4_tleminen.Vari_paksuusFragmentti"
        android:fitsSystemWindows="true"
        tools:layout="@layout/fragment_vari_paksuus_fragmentti" />



    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/FileMenuFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:name="com.example.vko4_tleminen.buttonitFragmentti"
        tools:layout="@layout/fragment_buttonit_fragmentti" />

</androidx.constraintlayout.widget.ConstraintLayout>



